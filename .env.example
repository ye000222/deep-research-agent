APP_NAME=DeepResearch Agent
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Business data and the official LangGraph checkpoint database are isolated.
DATABASE_URL=postgresql+psycopg://deep_research:deep_research@postgres:5432/deep_research
CHECKPOINT_DATABASE_URI=postgresql://deep_research:deep_research@postgres:5432/deep_research_checkpoint
REDIS_URL=redis://redis:6379/0
SEARXNG_BASE_URL=http://searxng:8080
ARTIFACT_ROOT=/app/artifacts

# Strict checkpoint serialization. Keep enabled outside explicitly isolated tests.
LANGGRAPH_STRICT_MSGPACK=true

# Development can create a durable key under artifacts/. Production must inject Base64.
PERSIST_PROVIDER_CREDENTIALS=true
SECRET_MASTER_KEY_FILE=artifacts/.secrets/provider_master_key
# SECRET_MASTER_KEY_BASE64=
PROVIDER_SESSION_COOKIE_NAME=dr_client_session
ALLOW_INSECURE_PROVIDER_ENDPOINTS=true

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
