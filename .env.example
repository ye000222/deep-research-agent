APP_NAME=DeepResearch Agent
APP_ENV=development
APP_VERSION=1.0.0-rc.1
SOURCE_REVISION=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Business data and the official LangGraph checkpoint database are isolated.
DATABASE_URL=postgresql+psycopg://deep_research:deep_research@postgres:5432/deep_research
CHECKPOINT_DATABASE_URI=postgresql://deep_research:deep_research@postgres:5432/deep_research_checkpoint
REDIS_URL=redis://redis:6379/0
SEARXNG_BASE_URL=http://searxng:8080
# Phase 12.4 provider pool. Brave is used as the first-priority provider only
# when BRAVE_API_KEY is set; leave it blank to omit Brave from the registry.
# BRAVE_API_KEY=
# DuckDuckGo is a key-free fallback provider for development / benchmark runs.
DUCKDUCKGO_ENABLED=true
# Phase 14.3 A/B switch: controls ONLY the Research Loop query enrichment
# (ResearchContextEnricher). Phase 14.5 closeout: disabled by default for V1
# (no A/B quality gain, hints duplicate the 14.1 candidate path); set to true
# only for deliberate experiments. false keeps Planner -> Provider byte-identical.
EVIDENCE_AWARE_CONTEXT_ENABLED=false
# Consecutive failed cooldown re-probes before a provider is disabled for the run.
PROVIDER_MAX_PROBE_FAILURES=3
  # Optional Docker-reachable proxy for external model calls. Leave blank when
  # direct model egress works.
  # MODEL_HTTP_PROXY=http://host.docker.internal:7078
  # Optional Docker-reachable proxy for public page reads. It may differ from
  # the model route (for example, proxied web plus direct model calls).
  # PUBLIC_WEB_HTTP_PROXY=http://host.docker.internal:7078
ARTIFACT_ROOT=/app/artifacts

# Strict checkpoint serialization. Keep enabled outside explicitly isolated tests.
LANGGRAPH_STRICT_MSGPACK=true

# Development can create a durable key under artifacts/. Production must inject Base64.
PERSIST_PROVIDER_CREDENTIALS=true
SECRET_MASTER_KEY_FILE=artifacts/.secrets/provider_master_key
# SECRET_MASTER_KEY_BASE64=
PROVIDER_SESSION_COOKIE_NAME=dr_client_session
ALLOW_INSECURE_PROVIDER_ENDPOINTS=true

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
INDEPENDENT_SOURCE_TARGETING_ENABLED=true
EVIDENCE_INPUT_QUALITY_ENABLED=false
