  "metrics_schema": {
    "recording_rule": "每次运行保存一个不可变 Metrics Snapshot；字段缺失时记录 null 和 unavailable_reason，不用推测值补齐。",
    "fields": [
      {
        "name": "run_id",
        "group": "configuration",
        "source": "research_runs.id",
        "calculation": "当前运行的唯一 ID。"
      },
      {
        "name": "benchmark_id",
        "group": "configuration",
        "source": "fixture",
        "calculation": "本文件中的 benchmark_id。"
      },
      {
        "name": "benchmark_version",
        "group": "configuration",
        "source": "fixture",
        "calculation": "本文件中的 benchmark_version。"
      },
      {
        "name": "code_commit",
        "group": "configuration",
        "source": "git",
        "calculation": "运行开始时的 HEAD commit。"
      },
      {
        "name": "model",
        "group": "configuration",
        "source": "research_runs.llm_config_snapshot",
        "calculation": "运行实际使用的模型。"
      },
      {
        "name": "provider",
        "group": "configuration",
        "source": "research_runs.llm_config_snapshot",
        "calculation": "运行实际使用的模型提供方。"
      },
      {
        "name": "budget",
        "group": "configuration",
        "source": "research_runs.budget_snapshot or usage_snapshot",
        "calculation": "运行时预算配置及消耗快照。"
      },
      {
        "name": "question_count",
        "group": "planning",
        "source": "research_plan_items",
        "calculation": "当前最终 plan version 的问题数。"
      },
      {
        "name": "p0_count",
        "group": "planning",
        "source": "research_plan_items.priority",
        "calculation": "runtime priority=1 的问题数；见 priority_mapping。"
      },
      {
        "name": "p1_count",
        "group": "planning",
        "source": "research_plan_items.priority",
        "calculation": "runtime priority=2 的问题数。"
      },
      {
        "name": "p2_count",
        "group": "planning",
        "source": "research_plan_items.priority",
        "calculation": "runtime priority=3 的问题数。"
      },
      {
        "name": "plan_version",
        "group": "planning",
        "source": "research_runs.plan_version",
        "calculation": "最终使用的 plan version。"
      },
      {
        "name": "runtime_coverage_mapping",
        "group": "planning",
        "source": "run-time plan/evaluator record",
        "calculation": "问题 ID 到 fixture coverage dimension ID 的映射；Generalization 必须在运行结果中保存。"
      },
      {
        "name": "provider_requests",
        "group": "search",
        "source": "usage_snapshot.search_provider_requests or search.completed.metrics.provider_requests",
        "calculation": "向搜索 provider 发出的请求次数。"
      },
      {
        "name": "logical_queries",
        "group": "search",
        "source": "usage_snapshot.logical_queries or research_search_queries",
        "calculation": "逻辑查询数；排除明确标记为 cache reuse 的请求。"
      },
      {
        "name": "search_candidates",
        "group": "search",
        "source": "usage_snapshot.candidate_urls or search event result_count",
        "calculation": "搜索返回的候选 URL 数。"
      },
      {
        "name": "relevant_candidates",
        "group": "search",
        "source": "run-time relevance record",
        "calculation": "被判定与问题相关的候选数；当前 baseline schema 未持久化时记录 null，不从 accepted evidence 反推。",
        "availability": "not_persisted_in_current_baseline"
      },
      {
        "name": "read_attempts",
        "group": "reading",
        "source": "usage_snapshot.page_fetch_attempts",
        "calculation": "页面读取尝试次数。"
      },
      {
        "name": "successful_reads",
        "group": "reading",
        "source": "source.fetched events",
        "calculation": "成功取得页面内容的来源数。"
      },
      {
        "name": "failed_reads",
        "group": "reading",
        "source": "usage_snapshot.page_read_failures or source.rejected events",
        "calculation": "读取失败或被拒绝的来源数。"
      },
      {
        "name": "extraction_count",
        "group": "reading",
        "source": "usage_snapshot.extraction_calls or evidence.extraction_started events",
        "calculation": "证据抽取调用次数。"
      },
      {
        "name": "candidate_evidence",
        "group": "evidence",
        "source": "quality_snapshot.candidate_evidence",
        "calculation": "候选证据条数。"
      },
      {
        "name": "accepted_evidence",
        "group": "evidence",
        "source": "quality_snapshot.accepted_evidence",
        "calculation": "通过现有 Evidence Acceptance 的证据条数。"
      },
      {
        "name": "rejected_evidence",
        "group": "evidence",
        "source": "quality_snapshot or evidence records",
        "calculation": "候选证据中未被接受的条数；不能把缺失记录默认为拒绝。"
      },
      {
        "name": "independent_source_count",
        "group": "evidence",
        "source": "quality_snapshot.independent_source_count",
        "calculation": "接受证据覆盖的独立 source_owner 数。"
      },
      {
        "name": "coverage",
        "group": "research_quality",
        "source": "quality_snapshot.coverage",
        "calculation": "沿用当前 V1 quality snapshot 的 coverage。"
      },
      {
        "name": "priority_one_coverage",
        "group": "research_quality",
        "source": "quality_snapshot.priority_one_coverage",
        "calculation": "保留当前 V1 生产指标原名和语义；在本 fixture 的三档映射中等价于 P0 coverage。"
      },
      {
        "name": "cross_validation",
        "group": "research_quality",
        "source": "quality_snapshot.cross_validation",
        "calculation": "沿用当前 V1 quality snapshot 的 cross validation。"
      },
      {
        "name": "critical_gaps",
        "group": "research_quality",
        "source": "quality_snapshot.critical_gaps",
        "calculation": "沿用当前 V1 quality snapshot 的关键缺口列表。"
      },
      {
        "name": "replans",
        "group": "agent_behavior",
        "source": "usage_snapshot.replans or replan events",
        "calculation": "发生的 replan 次数；不对 replan 行为设定新的通过阈值。"
      },
      {
        "name": "retry_count",
        "group": "agent_behavior",
        "source": "question.retry_scheduled events",
        "calculation": "问题级 retry 次数。"
      },
      {
        "name": "search_reused",
        "group": "agent_behavior",
        "source": "usage_snapshot.search_reuses or search reuse events",
        "calculation": "被标记为复用的搜索次数。"
      },
      {
        "name": "source_space_exhausted",
        "group": "agent_behavior",
        "source": "search.source_space_exhausted events",
        "calculation": "source space exhausted 事件次数。"
      },
      {
        "name": "question_yielded",
        "group": "agent_behavior",
        "source": "usage_snapshot.question_yields or question.yielded events",
        "calculation": "被 yield 的问题数。"
      },
      {
        "name": "budget_usage",
        "group": "agent_behavior",
        "source": "usage_snapshot and budget_snapshot",
        "calculation": "请求、读取、抽取、时间等预算池的配置与实际消耗。"
      },
      {
        "name": "termination_status",
        "group": "agent_behavior",
        "source": "research_runs.status and termination event",
        "calculation": "运行结束状态及终止原因。"
      }
    ]
  },
  "run_record_schema": {
    "storage": "可先保存为与 benchmark fixture 同版本控制策略一致的 JSON/JSONB 记录；不新增运行时表，不改变现有 DB schema。",
    "required_fields": [
      "run_id",
      "benchmark_id",
      "benchmark_version",
      "code_commit",
      "plan_version",
      "metrics_snapshot",
      "evidence_summary",
      "termination_status"
    ],
    "record": {
      "run_id": "string",
      "benchmark_id": "string",
      "benchmark_version": "string",
      "code_commit": "string",
      "plan_version": "integer|null",
      "planner_input_goal": "string",
      "planner_output": "object|null",
      "metrics_snapshot": "object",
      "evidence_summary": {
        "candidate_evidence": "integer|null",
        "accepted_evidence": "integer|null",
        "independent_source_count": "integer|null",
        "critical_gaps": "array|null"
      },
      "termination_status": {
        "status": "string",
        "reason": "string|null"
      },
      "unavailable_metrics": "array"
    },
    "generalization_requirement": "动态 Planner 的实际输出、问题数、优先级分布和 coverage mapping 必须随 run record 保存；不能用预设 Reference Plan 代替。"
  },
  "later_run_plan": {
    "development": "使用冻结 Reference Plan，先运行并记录完整 Metrics Snapshot，再将结果作为后续回归比较基线。",
    "generalization": "每个 benchmark 至少运行一次动态 Planner；记录 planner input/output、question count、priority counts、coverage mapping 和完整指标。",
    "comparison": "先比较同一 benchmark/version 下不同 code commit；benchmark version 变化时不直接混合比较。",
    "not_done_in_phase_1": [
      "付费真实 E2E",
      "Gap repair",
      "cache reuse 根因修复",
      "source_space_exhausted 根因修复",
      "Research Loop、Scheduler、Budget、Coverage、Evidence Acceptance、Planner 或 Search 行为修改"
    ]
  }
}
